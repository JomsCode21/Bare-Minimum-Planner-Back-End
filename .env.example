PORT=5000
NODE_ENV=development
MONGO_DB_URI= "mongodb://localhost:27017/todolist"

CORS_ORIGINS=http://localhost:5173
GLOBAL_RATE_LIMIT_MINUTES=0.5
GLOBAL_RATE_LIMIT_MAX=20
JWT_SECRET=super_long_random_string_that_nobody_can_guess_123!

# Example: smtp.zoho.com
MAIL_HOST=smtp.gmail.com

# Port for the SMTP host (commonly 465 for secure connections).
# Example: 465
MAIL_PORT=465

# Email address used as the sender.
# Example: cloudsupport@cloudmateria.com
# Example: recruitment@waynenterprisesolution.com
MAIL=

# Password for the sender email account.
MAIL_PASSWORD=pogidapat

# Generate matching VAPID keys with: npx web-push generate-vapid-keys --json
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
